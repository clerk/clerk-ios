  "strings" : {
    "A Watch identity metadata transition is still pending." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال انتقال بيانات تعريف هوية Watch معلقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Metadatenübertragung der Watch-Identität steht noch aus."
          }
